                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Expected Price ₹ *
                        </label>

                        <input
                            id="sellPrice"
                            class="input"
                            type="number"
                            min="1"
                            required
                            placeholder="30000"
                        >

                    </div>


                    <div class="form-group">

                        <label>
