    if(item.image){

        image = `
            <img
                src="${escapeHTML(item.image)}"
                alt="${escapeHTML(item.brand + " " + item.model)}"
            >
        `;

    }else{

        image = `
            <div class="phone-placeholder"></div>
        `;

    }


    document
    .getElementById("detailContent")
    .innerHTML = `

        <div class="detail-layout">

            <div class="detail-photo">
                ${image}
            </div>


            <div>

                <div class="detail-title">
                    ${escapeHTML(item.brand)}
                    ${escapeHTML(item.model)}
                </div>

                <div class="detail-location">
                    📍 ${escapeHTML(item.city || "India")}
                </div>

                <div class="detail-price">
                    ₹${Number(item.price).toLocaleString("en-IN")}
                </div>


                <div class="detail-spec-grid">

                    <div class="detail-spec">
                        <small>RAM</small>
                        <b>${escapeHTML(item.ram || "Not specified")}</b>
                    </div>

                    <div class="detail-spec">
                        <small>Storage</small>
                        <b>${escapeHTML(item.storage || "Not specified")}</b>
                    </div>

                    <div class="detail-spec">
                        <small>Condition</small>
                        <b>${escapeHTML(item.condition || "Not specified")}</b>
                    </div>

                    <div class="detail-spec">
                        <small>Battery Health</small>
                        <b>${escapeHTML(item.battery || "Not specified")}</b>
                    </div>

                    <div class="detail-spec">
                        <small>Purchase Year</small>
                        <b>${escapeHTML(item.year || "Not specified")}</b>
                    </div>

                    <div class="detail-spec">
                        <small>Warranty</small>
                        <b>${escapeHTML(item.warranty || "Not specified")}</b>
                    </div>

                </div>


                <div class="detail-description">
                    ${escapeHTML(item.description || "No description provided.")}
                </div>


                <div class="detail-actions">

                    <button
                        class="btn btn-primary"
                        onclick="openEnquiry(${item.id});closeModal('detailModal')"
                    >
                        📩 Contact Seller
                    </button>

                    <button
                        class="btn btn-secondary"
                        onclick="toggleWishlist(${item.id})"
                    >
                        ${
                            wishlist.includes(item.id)
                            ?
                            "♥ Wishlisted"
                            :
                            "♡ Wishlist"
                        }
                    </button>

                    <button
                        class="btn btn-secondary"
                        onclick="toggleCompare(${item.id})"
                    >
                        ⚖ Compare
                    </button>

                    <button
                        class="btn btn-secondary"
                        onclick="shareListing(${item.id})"
                    >
                        ↗ Share
                    </button>

                    <button
                        class="btn btn-danger"
                        onclick="openReport(${item.id})"
                    >
                        🚨 Report
                    </button>

                </div>


                <div class="seller-card">

                    <div class="seller-avatar">
                        ${getInitials(item.seller || "Seller")}
                    </div>

                    <div>

                        <strong>
                            ${escapeHTML(item.seller || "Seller")}
                        </strong>

                        <div
                            class="muted small"
                        >
                            Marketplace seller
                        </div>

                    </div>

                </div>

            </div>

        </div>

    `;


    openModal("detailModal");

}


/* =========================================================
   SHARE
   ========================================================= */

async function shareListing(id){

    const item =
        listings.find(
            mobile => mobile.id === id
        );


    if(!item){
        return;
    }


    const title =
        `${item.brand} ${item.model}`;


    const text =
        `${title} — ₹${Number(item.price).toLocaleString("en-IN")} on MobileMarket`;


    try{

        if(navigator.share){

            await navigator.share({
                title:title,
                text:text,
                url:window.location.href
            });

        }else{

            await navigator.clipboard.writeText(
                text + " | " + window.location.href
            );

            showToast(
                "Listing information copied",
                "success"
            );

        }

    }catch(error){

        console.log(error);

    }

}


/* =========================================================
   COMPARE
   ========================================================= */

function toggleCompare(id){

    if(compareList.includes(id)){

        compareList =
            compareList.filter(
                item => item !== id
            );

        showToast(
            "Removed from comparison"
        );

    }else{

        if(compareList.length >= 2){

            showToast(
                "Maximum 2 phones can be compared",
                "warning"
            );

            return;

        }


        compareList.push(id);

        showToast(
            "Added to comparison",
            "success"
        );

    }


    renderListings();

}


/* =========================================================
   OPEN COMPARE
   ========================================================= */

function openCompare(){

    const selected =
        compareList
        .map(
            id =>
                listings.find(
                    item => item.id === id
                )
        )
        .filter(Boolean);


    const container =
        document.getElementById("compareContent");


    if(selected.length === 0){

        container.innerHTML = `

            <div class="empty-state">

                <div class="empty-icon">
                    ⚖
                </div>

                <h3>
                    No phones selected
                </h3>

                <p>
                    Add phones from the marketplace to compare them.
                </p>

            </div>

        `;

        openModal("compareModal");

        return;

    }


    if(selected.length === 1){

        container.innerHTML = `

            <div class="empty-state">

                <div class="empty-icon">
                    ⚖
                </div>

                <h3>
                    Add one more phone
                </h3>

                <p>
                    Select another phone to create a comparison.
                </p>

            </div>

        `;

        openModal("compareModal");

        return;

    }


    container.innerHTML = `

        <div class="compare-wrap">

            <table class="compare-table">

                <thead>

                    <tr>

                        <th>
                            Specification
                        </th>

                        ${selected.map(
                            item =>
                            `
                                <th>
                                    ${escapeHTML(item.brand)}
                                    ${escapeHTML(item.model)}
                                </th>
                            `
                        ).join("")}

                    </tr>

                </thead>


                <tbody>

                    <tr>
                        <td>Price</td>
                        ${selected.map(
                            item =>
                            `<td>₹${Number(item.price).toLocaleString("en-IN")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>RAM</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.ram || "—")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>Storage</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.storage || "—")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>Condition</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.condition || "—")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>Battery</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.battery || "—")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>Purchase Year</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.year || "—")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>Warranty</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.warranty || "—")}</td>`
                        ).join("")}
                    </tr>

                    <tr>
                        <td>City</td>
                        ${selected.map(
                            item =>
                            `<td>${escapeHTML(item.city || "—")}</td>`
                        ).join("")}
                    </tr>

                </tbody>

            </table>

        </div>


        <div
            style="margin-top:18px;display:flex;gap:8px;flex-wrap:wrap;"
        >

            <button
                class="btn btn-danger"
                onclick="clearCompare()"
            >
                Clear Comparison
            </button>

        </div>

    `;


    openModal("compareModal");

}


/* =========================================================
   CLEAR COMPARE
   ========================================================= */

function clearCompare(){

    compareList = [];

    closeModal("compareModal");

    renderListings();

    showToast(
        "Comparison cleared"
    );

}


/* =========================================================
   ENQUIRY
   ========================================================= */

function openEnquiry(id){

    const item =
        listings.find(
            mobile => mobile.id === id
        );


    if(!item){
        return;
    }


    document
    .getElementById("enquiryListingId")
    .value = id;


    document
    .getElementById("enquiryPhoneTitle")
    .textContent =
        `Send an enquiry about ${item.brand} ${item.model} — ₹${Number(item.price).toLocaleString("en-IN")}`;


    document
    .getElementById("enquiryMessage")
    .value =
        `Hi, I am interested in the ${item.brand} ${item.model}. Is it still available?`;


    if(currentUser){

        document
        .getElementById("enquiryName")
        .value =
            currentUser.name || "";

        document
        .getElementById("enquiryEmail")
        .value =
            currentUser.email || "";

    }


    openModal("enquiryModal");

}


/* =========================================================
   SEND ENQUIRY
   ========================================================= */

function sendEnquiry(event){

    event.preventDefault();


    const listingId =
        Number(
            document
            .getElementById("enquiryListingId")
            .value
        );


    const item =
        listings.find(
            mobile => mobile.id === listingId
        );


    const phone =
        document
        .getElementById("enquiryPhone")
        .value
        .trim();


    if(!/^[0-9]{10}$/.test(phone)){

        showToast(
            "Enter a valid 10-digit phone number",
            "error"
        );

        return;

    }


    const enquiry = {

        id:Date.now(),

        listingId:listingId,

        listing:
            item
            ?
            `${item.brand} ${item.model}`
            :
            "",

        name:
            document
            .getElementById("enquiryName")
            .value
            .trim(),

        phone:phone,

        email:
            document
            .getElementById("enquiryEmail")
            .value
            .trim(),

        message:
            document
            .getElementById("enquiryMessage")
            .value
            .trim(),

        createdAt:
            new Date().toISOString()

    };


    let enquiries = [];


    try{

        enquiries =
            JSON.parse(
                localStorage.getItem("mobilemarket_enquiries") || "[]"
            );

    }catch(error){

        enquiries = [];

    }


    enquiries.push(enquiry);


    localStorage.setItem(
        "mobilemarket_enquiries",
        JSON.stringify(enquiries)
    );


    event.target.reset();


    closeModal("enquiryModal");


    showToast(
        "Enquiry submitted successfully",
        "success"
    );

}


/* =========================================================
   SUBMIT LISTING
   ========================================================= */

function submitListing(event){

    event.preventDefault();


    const phone =
        document
        .getElementById("sellerPhone")
        .value
        .trim();


    if(!/^[0-9]{10}$/.test(phone)){

        showToast(
            "Enter a valid 10-digit phone number",
            "error"
        );

        return;

    }


    const price =
        Number(
            document
            .getElementById("sellPrice")
            .value
        );


    if(price <= 0){

        showToast(
            "Enter a valid price",
            "error"
        );

        return;

    }


    const listing = {

        id:Date.now(),

        brand:
            document
            .getElementById("sellBrand")
            .value,

        model:
            document
            .getElementById("sellModel")
            .value
            .trim(),

        ram:
            document
            .getElementById("sellRam")
            .value,

        storage:
            document
            .getElementById("sellStorage")
            .value,

        condition:
            document
            .getElementById("sellCondition")
            .value,

        battery:
            document
            .getElementById("sellBattery")
            .value
            .trim(),

        year:
            document
            .getElementById("sellYear")
            .value,

        price:price,

        city:
            document
            .getElementById("sellerCity")
            .value
            .trim(),

        image:
            document
            .getElementById("sellImage")
            .value
            .trim(),

        warranty:
            document
            .getElementById("sellWarranty")
            .value,

        seller:
            document
            .getElementById("sellerName")
            .value
            .trim(),

        sellerPhone:phone,

        description:
            document
            .getElementById("sellDescription")
            .value
            .trim(),

        verified:false,

        createdAt:
            new Date().toISOString()

    };


    let customListings = [];


    try{

        customListings =
            JSON.parse(
                localStorage.getItem("mobilemarket_custom_listings") || "[]"
            );

    }catch(error){

        customListings = [];

    }


    customListings.unshift(listing);


    localStorage.setItem(
        "mobilemarket_custom_listings",
        JSON.stringify(customListings)
    );


    listings.unshift(listing);


    event.target.reset();


    renderListings();

    updateStats();


    showToast(
        "Your listing was created",
        "success"
    );


    document
    .getElementById("marketplace")
    .scrollIntoView({
        behavior:"smooth"
    });

}


/* =========================================================
   CONTACT
   ========================================================= */

function sendContact(event){

    event.preventDefault();


    const message = {

        id:Date.now(),

        name:
            document
            .getElementById("contactName")
            .value
            .trim(),

        email:
            document
            .getElementById("contactEmail")
            .value
            .trim(),

        subject:
            document
            .getElementById("contactSubject")
            .value
            .trim(),

        message:
            document
            .getElementById("contactMessage")
            .value
            .trim(),

        createdAt:
            new Date().toISOString()

    };


    let messages = [];


    try{

        messages =
            JSON.parse(
                localStorage.getItem("mobilemarket_messages") || "[]"
            );

    }catch(error){

        messages = [];

    }


    messages.push(message);


    localStorage.setItem(
        "mobilemarket_messages",
        JSON.stringify(messages)
    );


    event.target.reset();


    showToast(
        "Your message was submitted",
        "success"
    );

}


/* =========================================================
   AUTH
   ========================================================= */

function openAuth(mode){

    authMode = mode;

    updateAuthUI();

    openModal("authModal");

}


function toggleAuthMode(){

    authMode =
        authMode === "login"
        ?
        "signup"
        :
        "login";


    updateAuthUI();

}


function updateAuthUI(){

    const title =
        document.getElementById("authTitle");

    const button =
        document.getElementById("authButtonText");

    const nameGroup =
        document.getElementById("authNameGroup");

    const switchText =
        document.getElementById("authSwitchText");


    if(authMode === "signup"){

        title.textContent =
            "Create Account";

        button.textContent =
            "Create Account";

        nameGroup.style.display =
            "flex";

        switchText.textContent =
            "Already have an account?";

    }else{

        title.textContent =
            "Login";

        button.textContent =
            "Login";

        nameGroup.style.display =
            "none";

        switchText.textContent =
            "Don't have an account?";

    }

}


/* =========================================================
   HANDLE AUTH
   ========================================================= */

function handleAuth(event){

    event.preventDefault();


    const email =
        document
        .getElementById("authEmail")
        .value
        .trim()
        .toLowerCase();


    const password =
        document
        .getElementById("authPassword")
        .value;


    let users = [];


    try{

        users =
            JSON.parse(
                localStorage.getItem("mobilemarket_users") || "[]"
            );

    }catch(error){

        users = [];

    }


    if(authMode === "signup"){

        const name =
            document
            .getElementById("authName")
            .value
            .trim();


        if(name.length < 2){

            showToast(
                "Enter your name",
                "error"
            );

            return;

        }


        if(users.some(
            user => user.email === email
        )){

            showToast(
                "An account with this email already exists",
                "error"
            );

            return;

        }


        const user = {

            id:Date.now(),

            name:name,

            email:email,

            password:password

        };


        users.push(user);


        localStorage.setItem(
            "mobilemarket_users",
            JSON.stringify(users)
        );


        currentUser = {

            id:user.id,

            name:user.name,

            email:user.email

        };


        localStorage.setItem(
            "mobilemarket_current_user",
            JSON.stringify(currentUser)
        );


        closeModal("authModal");

        updateNavigation();


        showToast(
            "Account created successfully",
            "success"
        );


        event.target.reset();


    }else{

        const user =
            users.find(
                item =>
                    item.email === email &&
                    item.password === password
            );


        if(!user){

            showToast(
                "Invalid email or password",
                "error"
            );

            return;

        }


        currentUser = {

            id:user.id,

            name:user.name,

            email:user.email

        };


        localStorage.setItem(
            "mobilemarket_current_user",
            JSON.stringify(currentUser)
        );


        closeModal("authModal");

        updateNavigation();


        showToast(
            "Login successful",
            "success"
        );


        event.target.reset();

    }

}


/* =========================================================
   LOGOUT
   ========================================================= */

function logoutUser(){

    currentUser = null;


    localStorage.removeItem(
        "mobilemarket_current_user"
    );


    updateNavigation();


    showToast(
        "Logged out successfully"
    );

}


/* =========================================================
   NAVIGATION UPDATE
   ========================================================= */

function updateNavigation(){

    const loginBtn =
        document.getElementById("loginNavBtn");

    const logoutBtn =
        document.getElementById("logoutNavBtn");

    const pill =
        document.getElementById("userPill");

    const name =
        document.getElementById("userNameNav");

    const avatar =
        document.getElementById("userAvatar");


    if(currentUser){

        loginBtn.classList.add("hidden");

        logoutBtn.classList.remove("hidden");

        pill.style.display =
            "flex";

        name.textContent =
            currentUser.name || "User";

        avatar.textContent =
            getInitials(
                currentUser.name || "User"
            );

    }else{

        loginBtn.classList.remove("hidden");

        logoutBtn.classList.add("hidden");

        pill.style.display =
            "none";

    }

}


/* =========================================================
   DASHBOARD
   ========================================================= */

function showDashboard(){

    if(!currentUser){

        showToast(
            "Please login first",
            "warning"
        );

        openAuth("login");

        return;

    }


    const myListings =
        listings.filter(
            item =>
                item.seller === currentUser.name
        );


    let enquiries = [];


    try{

        enquiries =
            JSON.parse(
                localStorage.getItem("mobilemarket_enquiries") || "[]"
            );

    }catch(error){

        enquiries = [];

    }


    const myEnquiries =
        enquiries.filter(
            item =>
                item.email === currentUser.email
        );


    document
    .getElementById("dashboardContent")
    .innerHTML = `

        <div class="dashboard-grid">

            <div class="dashboard-card">
                <strong>${myListings.length}</strong>
                <span>Your Listings</span>
            </div>

            <div class="dashboard-card">
                <strong>${myEnquiries.length}</strong>
                <span>Your Enquiries</span>
            </div>

            <div class="dashboard-card">
                <strong>${wishlist.length}</strong>
                <span>Wishlist Items</span>
            </div>

        </div>


        <div
            style="margin-top:25px;"
        >

            <h3>
                Account
            </h3>

            <div
                class="seller-card"
                style="margin-top:12px;"
            >

                <div class="seller-avatar">
                    ${getInitials(currentUser.name)}
                </div>

                <div>

                    <strong>
                        ${escapeHTML(currentUser.name)}
                    </strong>

                    <div class="muted small">
                        ${escapeHTML(currentUser.email)}
                    </div>

                </div>

            </div>

        </div>


        <div
            style="margin-top:25px;"
        >

            <h3>
                Your Listings
            </h3>

            <div
                style="margin-top:12px;"
            >

                ${
                    myListings.length
                    ?
                    myListings.map(
                        item =>
                        `
                            <div
                                class="seller-card"
                                style="justify-content:space-between;"
                            >

                                <div>

                                    <strong>
                                        ${escapeHTML(item.brand)}
                                        ${escapeHTML(item.model)}
                                    </strong>

                                    <div class="muted small">
                                        ₹${Number(item.price).toLocaleString("en-IN")}
                                        •
                                        ${escapeHTML(item.condition)}
                                    </div>

                                </div>

                                <button
                                    class="btn btn-secondary btn-small"
                                    onclick="showDetails(${item.id})"
                                >
                                    View
                                </button>

                            </div>
                        `
                    ).join("")
                    :
                    `
                        <p class="muted small">
                            You have not created any listings yet.
                        </p>
                    `
                }

            </div>

        </div>

    `;


    openModal("dashboardModal");

}


/* =========================================================
   REPORT
   ========================================================= */

function openReport(id){

    document
    .getElementById("reportListingId")
    .value = id;


    closeModal("detailModal");

    openModal("reportModal");

}


function submitReport(event){

    event.preventDefault();


    const report = {

        id:Date.now(),

        listingId:
            Number(
                document
                .getElementById("reportListingId")
                .value
            ),

        reason:
            document
            .getElementById("reportReason")
            .value,

        details:
            document
            .getElementById("reportDetails")
            .value
            .trim(),

        createdAt:
            new Date().toISOString()

    };


    let reports = [];


    try{

        reports =
            JSON.parse(
                localStorage.getItem("mobilemarket_reports") || "[]"
            );

    }catch(error){

        reports = [];

    }


    reports.push(report);


    localStorage.setItem(
        "mobilemarket_reports",
        JSON.stringify(reports)
    );


    event.target.reset();


    closeModal("reportModal");


    showToast(
        "Report submitted",
        "success"
    );

}


/* =========================================================
   MODAL HELPERS
   ========================================================= */

function openModal(id){

    const modal =
        document.getElementById(id);


    if(!modal){
        return;
    }


    modal.classList.add("show");

    document.body.classList.add("modal-open");

}


function closeModal(id){

    const modal =
        document.getElementById(id);


    if(!modal){
        return;
    }


    modal.classList.remove("show");


    const anyOpen =
        document.querySelector(
            ".modal.show"
        );


    if(!anyOpen){
        document.body.classList.remove("modal-open");
    }

}


/* =========================================================
   CLOSE MODALS WHEN BACKDROP CLICKED
   ========================================================= */

document.addEventListener(
    "click",
    function(event){

        if(
            event.target.classList.contains("modal")
        ){

            event.target.classList.remove("show");

            const anyOpen =
                document.querySelector(".modal.show");

            if(!anyOpen){
                document.body.classList.remove("modal-open");
            }

        }

    }
);


/* =========================================================
   ESCAPE KEY
   ========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            document
            .querySelectorAll(".modal.show")
            .forEach(
                modal =>
                    modal.classList.remove("show")
            );

            document.body.classList.remove("modal-open");

        }

    }
);


/* =========================================================
   MOBILE NAVIGATION
   ========================================================= */

function toggleMobileNav(){

    document
    .getElementById("mobileNav")
    .classList.toggle("show");

}


function closeMobileNav(){

    document
    .getElementById("mobileNav")
    .classList.remove("show");

}


/* =========================================================
   SCROLL TO SELL
   ========================================================= */

function scrollToSell(){

    document
    .getElementById("sell")
    .scrollIntoView({
        behavior:"smooth"
    });

}


/* =========================================================
   TOAST
   ========================================================= */

function showToast(
    message,
    type="success"
){

    const container =
        document.getElementById("toastContainer");


    const toast =
        document.createElement("div");


    toast.className =
        `toast ${type}`;


    toast.textContent =
        message;


    container.appendChild(toast);


    setTimeout(
        function(){

            toast.style.opacity =
                "0";

            toast.style.transform =
                "translateY(10px)";


            setTimeout(
                function(){
                    toast.remove();
                },
                250
            );

        },
        3000
    );

}


/* =========================================================
   INITIALS
   ========================================================= */

function getInitials(name){

    if(!name){
        return "U";
    }


    return name
        .trim()
        .split(/\s+/)
        .slice(0,2)
        .map(
            word =>
                word.charAt(0).toUpperCase()
        )
        .join("");

}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(value){

    if(
        value === null ||
        value === undefined
    ){
        return "";
    }


    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =========================================================
   CONSOLE BRAND INFO
   ========================================================= */

console.log(
    "MobileMarket loaded successfully."
);

console.log(
    "Frontend marketplace initialized."
);

</script>

</body>
</html>
