     ========================================================= -->

<section id="safety">

    <div class="container">

        <div class="section-header">

            <div>

                <h2>
                    Marketplace Safety
                </h2>

                <p>
                    Basic precautions when buying or selling a used phone.
                </p>

            </div>

        </div>


        <div class="safety-box">

            <div class="safety-card">

                <h3>
                    🛡️ Buyer Checklist
                </h3>

                <ul class="safety-list">

                    <li>
                        Check the phone physically before paying.
                    </li>

                    <li>
                        Verify IMEI and device details where appropriate.
                    </li>

                    <li>
                        Check display, cameras, speakers, charging and buttons.
                    </li>

                    <li>
                        Ask about repairs, water damage and replaced parts.
                    </li>

                    <li>
                        Avoid sending advance money to unknown sellers.
                    </li>

                </ul>

            </div>


            <div class="safety-card">

                <h3>
                    🔐 Account Safety
                </h3>

                <ul class="safety-list">

                    <li>
                        Never share OTPs or passwords.
                    </li>

                    <li>
                        Do not send banking PINs to anyone.
                    </li>

                    <li>
                        Be careful with suspicious links.
                    </li>

                    <li>
                        Report suspicious listings when the feature is available.
                    </li>

                    <li>
                        Meet in a safe public location when appropriate.
                    </li>

                </ul>

            </div>

        </div>

    </div>

</section>


