        warranty:"Yes",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Vivo S2 with 8GB RAM and 128GB storage.",
        verified:true,
        createdAt:"2026-09-05"
    },

    {
        id:1004,
        brand:"OnePlus",
        model:"12R",
        ram:"8GB",
        storage:"256GB",
        condition:"Like New",
        battery:"96%",
        year:"2024",
        price:34000,
        city:"Mumbai",
        image:"",
        warranty:"Yes",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"OnePlus 12R with high storage and excellent battery health.",
        verified:true,
        createdAt:"2026-09-07"
    },

    {
        id:1005,
        brand:"Motorola",
        model:"Edge 70 Fusion",
        ram:"12GB",
        storage:"256GB",
        condition:"Like New",
        battery:"97%",
        year:"2026",
        price:35000,
        city:"Mumbai",
        image:"",
        warranty:"Yes",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Motorola Edge 70 Fusion with 12GB RAM and 256GB storage.",
        verified:true,
        createdAt:"2026-09-09"
    },

    {
        id:1006,
        brand:"Xiaomi",
        model:"Redmi Note Series",
        ram:"8GB",
        storage:"256GB",
        condition:"Good",
        battery:"90%",
        year:"2025",
        price:18000,
        city:"Mumbai",
        image:"",
        warranty:"No",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Redmi Note series phone in good condition.",
        verified:true,
        createdAt:"2026-09-10"
    },

    {
        id:1007,
        brand:"Google",
        model:"Pixel 9a",
        ram:"8GB",
        storage:"128GB",
        condition:"Excellent",
        battery:"95%",
        year:"2025",
        price:33000,
        city:"Mumbai",
        image:"",
        warranty:"Yes",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Google Pixel device in excellent condition.",
        verified:true,
        createdAt:"2026-09-11"
    },

    {
        id:1008,
        brand:"Nothing",
        model:"Phone Series",
        ram:"8GB",
        storage:"256GB",
        condition:"Excellent",
        battery:"93%",
        year:"2025",
        price:28000,
        city:"Mumbai",
        image:"",
        warranty:"Yes",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Nothing phone with 8GB RAM and 256GB storage.",
        verified:true,
        createdAt:"2026-09-12"
    },

    {
        id:1009,
        brand:"Realme",
        model:"GT Series",
        ram:"12GB",
        storage:"256GB",
        condition:"Good",
        battery:"91%",
        year:"2025",
        price:24000,
        city:"Mumbai",
        image:"",
        warranty:"No",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Realme GT series smartphone.",
        verified:true,
        createdAt:"2026-09-13"
    },

    {
        id:1010,
        brand:"Oppo",
        model:"Reno Series",
        ram:"8GB",
        storage:"256GB",
        condition:"Excellent",
        battery:"94%",
        year:"2025",
        price:27000,
        city:"Mumbai",
        image:"",
        warranty:"Yes",
        seller:"MobileMarket Seller",
        sellerPhone:"",
        description:"Oppo Reno series smartphone in excellent condition.",
        verified:true,
        createdAt:"2026-09-14"
    }

];


/* =========================================================
   STATE
   ========================================================= */

let wishlist = [];
let compareList = [];
let authMode = "login";
let currentDetailId = null;
let currentUser = null;


/* =========================================================
   LOAD LOCAL DATA
   ========================================================= */

function loadLocalData(){

    try{

        const custom =
            JSON.parse(
                localStorage.getItem("mobilemarket_custom_listings") || "[]"
            );

        if(Array.isArray(custom)){
            listings = [...custom,...listings];
        }

    }catch(error){

        console.log("Custom listings error:",error);

    }


    try{

        const savedWishlist =
            JSON.parse(
                localStorage.getItem("mobilemarket_wishlist") || "[]"
            );

        if(Array.isArray(savedWishlist)){
            wishlist = savedWishlist;
        }

    }catch(error){

        wishlist = [];

    }


    try{

        const savedUser =
            JSON.parse(
                localStorage.getItem("mobilemarket_current_user") || "null"
            );

        if(savedUser){
            currentUser = savedUser;
        }

    }catch(error){

        currentUser = null;

    }

}


/* =========================================================
   INITIALIZE
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        loadLocalData();

        updateNavigation();

        renderListings();

        updateStats();

    }
);


/* =========================================================
   UPDATE STATS
   ========================================================= */

function updateStats(){

    const element =
        document.getElementById("heroListingCount");

    if(element){
        element.textContent = listings.length;
    }

}


/* =========================================================
   RENDER LISTINGS
   ========================================================= */

function renderListings(){

    const grid =
        document.getElementById("mobileGrid");

    const empty =
        document.getElementById("emptyState");

    const resultText =
        document.getElementById("resultText");

    if(!grid){
        return;
    }


    const search =
        document
        .getElementById("searchInput")
        .value
        .trim()
        .toLowerCase();


    const brand =
        document
        .getElementById("brandFilter")
        .value;


    const condition =
        document
        .getElementById("conditionFilter")
        .value;


    const sort =
        document
        .getElementById("sortFilter")
        .value;


    const minPrice =
        Number(
            document
            .getElementById("minPrice")
            .value
        ) || 0;


    const maxPrice =
        Number(
            document
            .getElementById("maxPrice")
            .value
        ) || Infinity;


    const storage =
        document
        .getElementById("storageFilter")
        .value;


    const ram =
        document
        .getElementById("ramFilter")
        .value;


    let filtered =
        listings.filter(
            function(item){

                const searchable =
                    (
                        item.brand +
                        " " +
                        item.model +
                        " " +
                        item.city +
                        " " +
                        item.storage +
                        " " +
                        item.ram
                    )
                    .toLowerCase();


                const matchesSearch =
                    !search ||
                    searchable.includes(search);


                const matchesBrand =
                    !brand ||
                    item.brand === brand;


                const matchesCondition =
                    !condition ||
                    item.condition === condition;


                const matchesMin =
                    Number(item.price) >= minPrice;


                const matchesMax =
                    Number(item.price) <= maxPrice;


                const matchesStorage =
                    !storage ||
                    item.storage === storage;


                const matchesRam =
                    !ram ||
                    item.ram === ram;


                return (
                    matchesSearch &&
                    matchesBrand &&
                    matchesCondition &&
                    matchesMin &&
                    matchesMax &&
                    matchesStorage &&
                    matchesRam
                );

            }
        );


    /* SORT */

    if(sort === "low"){

        filtered.sort(
            (a,b)=>
                Number(a.price) -
                Number(b.price)
        );

    }


    if(sort === "high"){

        filtered.sort(
            (a,b)=>
                Number(b.price) -
                Number(a.price)
        );

    }


    if(sort === "battery"){

        filtered.sort(
            (a,b)=>
                parseBattery(b.battery) -
                parseBattery(a.battery)
        );

    }


    if(sort === "newest"){

        filtered.sort(
            (a,b)=>
                Number(b.id) -
                Number(a.id)
        );

    }


    grid.innerHTML = "";


    if(resultText){

        resultText.textContent =
            `${filtered.length} phone${filtered.length === 1 ? "" : "s"} found`;

    }


    if(filtered.length === 0){

        empty.classList.remove("hidden");

        return;

    }


    empty.classList.add("hidden");


    filtered.forEach(
        function(item){

            grid.appendChild(
                createListingCard(item)
            );

        }
    );

}


/* =========================================================
   CREATE LISTING CARD
   ========================================================= */

function createListingCard(item){

    const card =
        document.createElement("article");

    card.className =
        "mobile-card";


    const isWishlisted =
        wishlist.includes(item.id);


    const isCompared =
        compareList.includes(item.id);


    let imageHTML;


    if(item.image){

        imageHTML = `
            <img
                src="${escapeHTML(item.image)}"
                alt="${escapeHTML(item.brand + " " + item.model)}"
                onerror="this.style.display='none';this.parentElement.querySelector('.fallback-phone').style.display='block';"
            >

            <div
                class="phone-placeholder fallback-phone"
                style="display:none;"
            ></div>
        `;

    }else{

        imageHTML = `
            <div class="phone-placeholder"></div>
        `;

    }


    card.innerHTML = `

        <div class="mobile-image">

            ${imageHTML}

            <span class="badge">
                ${escapeHTML(item.condition)}
            </span>

            <button
                class="wishlist-btn ${isWishlisted ? "active" : ""}"
                onclick="toggleWishlist(${item.id})"
                title="Wishlist"
            >
                ${isWishlisted ? "♥" : "♡"}
            </button>

            ${
                item.verified
                ?
                `
                    <span class="verified-badge">
                        ✓ LISTING CHECK
                    </span>
                `
                :
                ""
            }

        </div>


        <div class="mobile-info">

            <div class="mobile-title">
                ${escapeHTML(item.brand)}
                ${escapeHTML(item.model)}
            </div>

            <div class="mobile-subtitle">
                📍 ${escapeHTML(item.city || "India")}
            </div>


            <div class="mobile-price">
                ₹${Number(item.price).toLocaleString("en-IN")}
                <span class="price-label">
                    asking price
                </span>
            </div>


            <div class="spec-mini">

                <span>
                    ${escapeHTML(item.ram || "—")} RAM
                </span>

                <span>
                    ${escapeHTML(item.storage || "—")}
                </span>

                <span>
                    🔋 ${escapeHTML(item.battery || "—")}
                </span>

                <span>
                    ${escapeHTML(item.year || "—")}
                </span>

            </div>


            <div class="card-buttons">

                <button
                    class="btn btn-secondary"
                    onclick="showDetails(${item.id})"
                >
                    Details
                </button>

                <button
                    class="btn btn-primary"
                    onclick="openEnquiry(${item.id})"
                >
                    Contact
                </button>

            </div>


            <button
                class="btn btn-secondary"
                style="width:100%;margin-top:8px;"
                onclick="toggleCompare(${item.id})"
            >
                ${isCompared ? "✓ Compared" : "⚖ Add to Compare"}
            </button>

        </div>

    `;


    return card;

}


/* =========================================================
   BATTERY PARSER
   ========================================================= */

function parseBattery(value){

    if(!value){
        return 0;
    }

    return Number(
        String(value)
        .replace("%","")
        .trim()
    ) || 0;

}


/* =========================================================
   SELECT BRAND
   ========================================================= */

function selectBrand(brand){

    document
    .getElementById("brandFilter")
    .value = brand;


    document
    .querySelectorAll(".brand-chip")
    .forEach(
        function(chip){

            chip.classList.remove("active");

            if(
                chip.textContent
                .trim()
                .toLowerCase()
                ===
                (brand || "all").toLowerCase()
            ){

                chip.classList.add("active");

            }

        }
    );


    renderListings();


    document
    .getElementById("marketplace")
    .scrollIntoView({
        behavior:"smooth"
    });

}


/* =========================================================
   RESET FILTERS
   ========================================================= */

function resetFilters(){

    document.getElementById("searchInput").value = "";
    document.getElementById("brandFilter").value = "";
    document.getElementById("conditionFilter").value = "";
    document.getElementById("sortFilter").value = "newest";
    document.getElementById("minPrice").value = "";
    document.getElementById("maxPrice").value = "";
    document.getElementById("storageFilter").value = "";
    document.getElementById("ramFilter").value = "";


    document
    .querySelectorAll(".brand-chip")
    .forEach(
        function(chip,index){

            chip.classList.toggle(
                "active",
                index === 0
            );

        }
    );


    renderListings();

}


/* =========================================================
   WISHLIST
   ========================================================= */

function toggleWishlist(id){

    if(wishlist.includes(id)){

        wishlist =
            wishlist.filter(
                item => item !== id
            );

        showToast(
            "Removed from wishlist"
        );

    }else{

        wishlist.push(id);

        showToast(
            "Added to wishlist",
            "success"
        );

    }


    localStorage.setItem(
        "mobilemarket_wishlist",
        JSON.stringify(wishlist)
    );


    renderListings();

}


/* =========================================================
   SHOW DETAILS
   ========================================================= */

function showDetails(id){

    const item =
