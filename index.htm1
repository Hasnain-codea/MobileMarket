<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#05070b">
<meta name="description" content="MobileMarket - Buy, sell, compare and discover smartphones.">
<title>MobileMarket — Smartphone Marketplace</title>

<style>

/* =========================================================
   MOBILEMARKET
   COMPLETE SINGLE-FILE FRONTEND
   ========================================================= */

/* ---------- RESET ---------- */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Arial,Helvetica,sans-serif;
    background:#05070b;
    color:#f5f7fb;
    line-height:1.6;
    overflow-x:hidden;
}

body.modal-open{
    overflow:hidden;
}

button,
input,
select,
textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

img{
    max-width:100%;
}

a{
    color:inherit;
    text-decoration:none;
}

/* ---------- VARIABLES ---------- */

:root{
    --bg:#05070b;
    --bg2:#080b12;
    --card:#0c1018;
    --card2:#101621;
    --border:#202938;
    --border2:#2b3548;
    --text:#f5f7fb;
    --muted:#8c97a9;
    --muted2:#687488;
    --primary:#6d8cff;
    --primary2:#526fff;
    --success:#40c98a;
    --danger:#ff6878;
    --warning:#f4b84d;
    --radius:18px;
    --shadow:0 20px 70px rgba(0,0,0,.35);
}

/* ---------- UTILITY ---------- */

.container{
    width:min(1180px,92%);
    margin:auto;
}

.hidden{
    display:none!important;
}

.text-center{
    text-align:center;
}

.muted{
    color:var(--muted);
}

.small{
    font-size:12px;
}

.full{
    grid-column:1/-1;
}

/* ---------- BUTTONS ---------- */

.btn{
    border:0;
    border-radius:12px;
    padding:11px 17px;
    font-weight:800;
    transition:.2s ease;
    display:inline-flex;
    justify-content:center;
    align-items:center;
    gap:8px;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-primary{
    background:var(--primary);
    color:#fff;
}

.btn-primary:hover{
    background:var(--primary2);
}

.btn-secondary{
    background:#131925;
    color:#fff;
    border:1px solid var(--border2);
}

.btn-secondary:hover{
    background:#1a2230;
}

.btn-success{
    background:#123326;
    color:#7af0b5;
    border:1px solid #245b43;
}

.btn-danger{
    background:#34151c;
    color:#ff9aa5;
    border:1px solid #632a35;
}

.btn-warning{
    background:#342814;
    color:#ffd178;
    border:1px solid #644d24;
}

.btn-small{
    padding:8px 11px;
    border-radius:9px;
    font-size:12px;
}

/* ---------- NAVBAR ---------- */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(5,7,11,.94);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--border);
}

.nav-inner{
    min-height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
}

.logo{
    font-size:25px;
    font-weight:950;
    letter-spacing:-1.5px;
    white-space:nowrap;
}

.logo span{
    color:var(--primary);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:25px;
}

.nav-links a{
    color:#aeb7c6;
    font-size:14px;
    font-weight:650;
}

.nav-links a:hover{
    color:#fff;
}

.nav-actions{
    display:flex;
    align-items:center;
    gap:9px;
}

.user-pill{
    display:none;
    align-items:center;
    gap:8px;
    padding:7px 10px;
    border-radius:10px;
    background:#111722;
    border:1px solid var(--border2);
    font-size:12px;
}

.user-avatar{
    width:28px;
    height:28px;
    display:grid;
    place-items:center;
    border-radius:50%;
    background:var(--primary);
    font-weight:900;
}

.menu-btn{
    display:none;
    width:42px;
    height:42px;
    border-radius:10px;
    border:1px solid var(--border2);
    background:#111722;
    color:#fff;
    font-size:21px;
}

.mobile-nav{
    display:none;
    padding:10px 0 18px;
}

.mobile-nav.show{
    display:block;
}

.mobile-nav a,
.mobile-nav button{
    display:block;
    width:100%;
    text-align:left;
    border:0;
    background:none;
    color:#aeb7c6;
    padding:12px;
    border-radius:10px;
}

.mobile-nav a:hover,
.mobile-nav button:hover{
    background:#111722;
    color:#fff;
}

/* ---------- HERO ---------- */

.hero{
    position:relative;
    padding:95px 0 75px;
    overflow:hidden;
    background:
        radial-gradient(circle at 15% 25%,rgba(109,140,255,.20),transparent 30%),
        radial-gradient(circle at 85% 30%,rgba(0,200,255,.08),transparent 28%),
        linear-gradient(180deg,#070a11,#05070b);
}

.hero:before{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:50px 50px;
    mask-image:linear-gradient(to bottom,black,transparent);
    pointer-events:none;
}

.hero-grid{
    position:relative;
    display:grid;
    grid-template-columns:1.15fr .85fr;
    gap:60px;
    align-items:center;
}

.hero-label{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:#91a6ff;
    font-size:12px;
    font-weight:900;
    letter-spacing:1.5px;
    margin-bottom:18px;
}

.live-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#45dc95;
    box-shadow:0 0 15px #45dc95;
}

.hero h1{
    font-size:clamp(44px,7vw,76px);
    line-height:1;
    letter-spacing:-4px;
    margin-bottom:24px;
}

.hero h1 span{
    color:var(--primary);
}

.hero-description{
    max-width:650px;
    color:#9da8ba;
    font-size:18px;
    margin-bottom:28px;
}

.hero-buttons{
    display:flex;
    gap:11px;
    flex-wrap:wrap;
}

.hero-trust{
    display:flex;
    flex-wrap:wrap;
    gap:18px;
    margin-top:28px;
    color:#7e899c;
    font-size:12px;
}

.hero-trust span{
    display:flex;
    align-items:center;
    gap:6px;
}

/* ---------- HERO PHONE ---------- */

.hero-showcase{
    min-height:470px;
    padding:28px;
    border:1px solid #252f42;
    border-radius:30px;
    background:
        radial-gradient(circle at 50% 40%,rgba(109,140,255,.13),transparent 45%),
        linear-gradient(145deg,#101621,#080b12);
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
}

.showcase-top{
    display:flex;
    justify-content:space-between;
    color:#7d899d;
    font-size:11px;
}

.phone-stage{
    min-height:340px;
    display:grid;
    place-items:center;
}

.big-phone{
    width:180px;
    height:340px;
    border-radius:35px;
    border:7px solid #252c3a;
    background:
        radial-gradient(circle at 50% 70%,rgba(109,140,255,.24),transparent 35%),
        linear-gradient(150deg,#192235,#06080d);
    box-shadow:
        0 35px 80px rgba(0,0,0,.7),
        0 0 80px rgba(109,140,255,.18);
    position:relative;
    transform:rotate(-7deg);
}

.big-phone:before{
    content:"";
    position:absolute;
    width:72px;
    height:18px;
    top:9px;
    left:47px;
    border-radius:20px;
    background:#05070b;
}

.phone-camera{
    position:absolute;
    top:27px;
    left:17px;
    width:54px;
    height:82px;
    border-radius:16px;
    background:#242d3d;
    padding:8px;
}

.phone-camera i{
    display:block;
    width:17px;
    height:17px;
    border-radius:50%;
    background:#07090e;
    margin-bottom:5px;
}

.phone-screen-text{
    position:absolute;
    bottom:30px;
    width:100%;
    text-align:center;
    color:#7485b9;
    font-size:12px;
    font-weight:900;
}

.showcase-bottom{
    display:flex;
    justify-content:space-between;
    color:#7d899d;
    font-size:12px;
}

/* ---------- STATS ---------- */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-top:35px;
}

.stat{
    padding:18px;
    border:1px solid var(--border);
    background:#0a0e15;
    border-radius:15px;
}

.stat strong{
    display:block;
    font-size:26px;
    line-height:1.1;
}

.stat span{
    display:block;
    margin-top:5px;
    color:var(--muted2);
    font-size:12px;
}

/* ---------- SECTION ---------- */

section{
    padding:80px 0;
}

.section-header{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:25px;
    margin-bottom:28px;
}

.section-header h2{
    font-size:35px;
    line-height:1.1;
    letter-spacing:-1.3px;
}

.section-header p{
    color:var(--muted);
    font-size:14px;
    margin-top:7px;
}

/* ---------- MARKETPLACE TOOLBAR ---------- */

.market-toolbar{
    background:#0a0e15;
    border:1px solid var(--border);
    border-radius:20px;
    padding:17px;
    margin-bottom:25px;
}

.search-row{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:10px;
}

.filter-row{
    display:grid;
    grid-template-columns:repeat(4,1fr) auto;
    gap:10px;
    margin-top:10px;
}

.input,
.select,
.textarea{
    width:100%;
    background:#111722;
    border:1px solid #293348;
    color:#fff;
    border-radius:11px;
    padding:12px 13px;
    outline:none;
}

.input::placeholder,
.textarea::placeholder{
    color:#5f6b7e;
}

.input:focus,
.select:focus,
.textarea:focus{
    border-color:var(--primary);
    box-shadow:0 0 0 3px rgba(109,140,255,.08);
}

.results-line{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:15px 0;
    color:#788498;
    font-size:12px;
}

/* ---------- BRAND QUICK FILTER ---------- */

.brand-strip{
    display:flex;
    gap:9px;
    overflow-x:auto;
    padding:3px 0 13px;
    scrollbar-width:none;
}

.brand-strip::-webkit-scrollbar{
    display:none;
}

.brand-chip{
    flex:0 0 auto;
    padding:9px 14px;
    border-radius:10px;
    background:#0e131c;
    border:1px solid var(--border);
    color:#929daf;
    font-size:12px;
    font-weight:750;
}

.brand-chip:hover,
.brand-chip.active{
    color:#fff;
    border-color:#4a5c91;
    background:#151d2e;
}

/* ---------- MOBILE GRID ---------- */

.mobile-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:19px;
}

.mobile-card{
    background:#0a0e15;
    border:1px solid var(--border);
    border-radius:20px;
    overflow:hidden;
    transition:.25s ease;
}

.mobile-card:hover{
    transform:translateY(-5px);
    border-color:#39465e;
    box-shadow:0 20px 50px rgba(0,0,0,.25);
}

.mobile-image{
    height:235px;
    background:
        radial-gradient(circle at center,rgba(109,140,255,.09),transparent 55%),
        #101620;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    overflow:hidden;
}

.mobile-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.phone-placeholder{
    width:90px;
    height:170px;
    border-radius:20px;
    border:5px solid #303a4d;
    background:linear-gradient(150deg,#182131,#080b10);
    position:relative;
    box-shadow:0 20px 40px rgba(0,0,0,.5);
}

.phone-placeholder:before{
    content:"";
    position:absolute;
    top:8px;
    left:25px;
    width:32px;
    height:9px;
    border-radius:20px;
    background:#05070b;
}

.phone-placeholder:after{
    content:"";
    position:absolute;
    top:23px;
    left:10px;
    width:27px;
    height:38px;
    border-radius:9px;
    background:#252e3e;
}

.badge{
    position:absolute;
    left:12px;
    top:12px;
    padding:6px 9px;
    background:rgba(5,7,11,.88);
    border:1px solid #3a465d;
    border-radius:8px;
    color:#dbe1ec;
    font-size:10px;
    font-weight:850;
}

.wishlist-btn{
    position:absolute;
    right:12px;
    top:12px;
    width:38px;
    height:38px;
    border-radius:50%;
    border:1px solid #3a465d;
    background:rgba(5,7,11,.88);
    color:#fff;
    font-size:18px;
}

.wishlist-btn.active{
    color:#ff6d7c;
}

.verified-badge{
    position:absolute;
    bottom:12px;
    left:12px;
    padding:5px 8px;
    border-radius:8px;
    background:rgba(7,40,28,.9);
    border:1px solid #245e46;
    color:#7aeeb5;
    font-size:9px;
    font-weight:900;
}

.mobile-info{
    padding:18px;
}

.mobile-title{
    font-size:18px;
    font-weight:850;
    margin-bottom:3px;
}

.mobile-subtitle{
    color:#778398;
    font-size:12px;
}

.mobile-price{
    margin-top:13px;
    font-size:24px;
    font-weight:950;
}

.price-label{
    color:#657185;
    font-size:10px;
    margin-left:4px;
    font-weight:500;
}

.spec-mini{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin:12px 0 15px;
}

.spec-mini span{
    background:#111722;
    border:1px solid #202b3d;
    border-radius:7px;
    padding:5px 7px;
    color:#929daf;
    font-size:10px;
}

.card-buttons{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
}

.card-buttons .btn{
    font-size:12px;
    padding:10px 8px;
}

/* ---------- EMPTY ---------- */

.empty-state{
    padding:70px 20px;
    border:1px dashed #2a3548;
    border-radius:18px;
    text-align:center;
    background:#090d14;
}

.empty-icon{
    font-size:42px;
    margin-bottom:10px;
}

.empty-state h3{
    margin-bottom:5px;
}

.empty-state p{
    color:var(--muted);
    font-size:13px;
}

/* ---------- CATEGORIES ---------- */

.category-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:12px;
}

.category{
    padding:20px 15px;
    background:#0a0e15;
    border:1px solid var(--border);
    border-radius:16px;
    text-align:center;
    transition:.2s;
}

.category:hover{
    transform:translateY(-3px);
    border-color:#39465e;
}

.category-icon{
    font-size:30px;
    margin-bottom:8px;
}

.category strong{
    display:block;
    font-size:13px;
}

.category small{
    color:#6f7b8f;
    font-size:10px;
}

/* ---------- WHY ---------- */

.why-section{
    background:#070a10;
}

.feature-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:17px;
}

.feature{
    padding:25px;
    border:1px solid var(--border);
    border-radius:18px;
    background:#0a0e15;
}

.feature-icon{
    width:48px;
    height:48px;
    display:grid;
    place-items:center;
    border-radius:13px;
    background:#141d2e;
    font-size:23px;
    margin-bottom:17px;
}

.feature h3{
    margin-bottom:7px;
    font-size:17px;
}

.feature p{
    color:#7f8a9d;
    font-size:13px;
}

/* ---------- HOW IT WORKS ---------- */

.steps{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.step{
    padding:28px;
    background:#0a0e15;
    border:1px solid var(--border);
    border-radius:20px;
    position:relative;
}

.step-number{
    font-size:12px;
    color:#8094ee;
    font-weight:900;
    letter-spacing:1px;
    margin-bottom:13px;
}

.step h3{
    margin-bottom:8px;
}

.step p{
    color:#7f8a9d;
    font-size:13px;
}

/* ---------- SELL SECTION ---------- */

.sell-section{
    background:
        radial-gradient(circle at 90% 50%,rgba(109,140,255,.10),transparent 30%),
        #070a10;
}

.sell-box{
    padding:32px;
    background:linear-gradient(145deg,#0e1420,#080b12);
    border:1px solid #273249;
    border-radius:25px;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:16px;
}

.form-group{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.form-group label{
    color:#aab4c4;
    font-size:12px;
    font-weight:800;
}

.textarea{
    min-height:135px;
    resize:vertical;
}

.form-hint{
    color:#667287;
    font-size:11px;
}

/* ---------- SELL BENEFITS ---------- */

.sell-benefits{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-top:20px;
}

.sell-benefit{
    padding:16px;
    background:#0b1019;
    border:1px solid var(--border);
    border-radius:13px;
}

.sell-benefit strong{
    display:block;
    font-size:13px;
    margin-bottom:4px;
}

.sell-benefit span{
    color:#727e91;
    font-size:11px;
}

/* ---------- SAFETY ---------- */

.safety-box{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.safety-card{
    padding:25px;
    border-radius:20px;
    border:1px solid var(--border);
    background:#0a0e15;
}

.safety-card h3{
    margin-bottom:14px;
}

.safety-list{
    list-style:none;
}

.safety-list li{
    display:flex;
    gap:9px;
    color:#8b96a8;
    font-size:13px;
    margin:10px 0;
}

.safety-list li:before{
    content:"✓";
    color:#55d89c;
    font-weight:900;
}

/* ---------- CONTACT ---------- */

.contact-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:20px;
}

.contact-info{
    padding:30px;
    border:1px solid var(--border);
    border-radius:22px;
    background:#0a0e15;
}

.contact-info h3{
    font-size:24px;
    margin-bottom:10px;
}

.contact-info p{
    color:#808b9e;
    font-size:13px;
}

.contact-item{
    display:flex;
    gap:13px;
    margin-top:22px;
}

.contact-icon{
    width:40px;
    height:40px;
    border-radius:11px;
    display:grid;
    place-items:center;
    background:#141b29;
}

.contact-item strong{
    display:block;
    font-size:13px;
}

.contact-item span{
    color:#758196;
    font-size:12px;
}

/* ---------- FOOTER ---------- */

footer{
    border-top:1px solid var(--border);
    background:#04060a;
    padding:50px 0 25px;
}

.footer-grid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:35px;
}

.footer-brand p{
    max-width:360px;
    color:#697589;
    font-size:12px;
    margin-top:11px;
}

.footer-col h4{
    font-size:13px;
    margin-bottom:13px;
}

.footer-col a{
    display:block;
    color:#6f7b8e;
    font-size:12px;
    margin:8px 0;
}

.footer-col a:hover{
    color:#fff;
}

.footer-bottom{
    border-top:1px solid var(--border);
    margin-top:35px;
    padding-top:20px;
    text-align:center;
    color:#586477;
    font-size:11px;
}

/* ---------- MODALS ---------- */

.modal{
    position:fixed;
    inset:0;
    z-index:3000;
    background:rgba(0,0,0,.78);
    backdrop-filter:blur(10px);
    display:none;
    align-items:center;
    justify-content:center;
    padding:16px;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(600px,100%);
    max-height:92vh;
    overflow:auto;
    padding:26px;
    border-radius:23px;
    background:#0c111a;
    border:1px solid #2b3548;
    box-shadow:0 30px 100px rgba(0,0,0,.65);
    position:relative;
}

.modal-box.large{
    width:min(950px,100%);
}

.close-btn{
    position:absolute;
    top:14px;
    right:14px;
    width:37px;
    height:37px;
    border-radius:50%;
    border:1px solid #303b4e;
    background:#151c28;
    color:#fff;
    font-size:20px;
}

.modal-title{
    font-size:25px;
    margin-bottom:20px;
    padding-right:45px;
}

/* ---------- DETAIL ---------- */

.detail-layout{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
}

.detail-photo{
    min-height:390px;
    border-radius:20px;
    background:#111722;
    display:grid;
    place-items:center;
    overflow:hidden;
}

.detail-photo img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.detail-title{
    font-size:32px;
    line-height:1.1;
}

.detail-location{
    color:#7c879a;
    font-size:12px;
    margin-top:5px;
}

.detail-price{
    font-size:30px;
    font-weight:950;
    margin:14px 0;
}

.detail-spec-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin:18px 0;
}

.detail-spec{
    padding:12px;
    background:#111722;
    border:1px solid #202b3c;
    border-radius:10px;
}

.detail-spec small{
    display:block;
    color:#69758a;
    font-size:10px;
}

.detail-spec b{
    font-size:12px;
}

.detail-description{
    color:#8994a7;
    font-size:13px;
    margin-bottom:18px;
}

.detail-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

/* ---------- SELLER ---------- */

.seller-card{
    margin-top:18px;
    padding:14px;
    border-radius:13px;
    background:#101621;
    border:1px solid #232e41;
    display:flex;
    align-items:center;
    gap:12px;
}

.seller-avatar{
    width:44px;
    height:44px;
    display:grid;
    place-items:center;
    border-radius:50%;
    background:#1a2742;
    color:#9eb0ff;
    font-weight:900;
}

/* ---------- AUTH ---------- */

.auth-note{
    padding:11px;
    border-radius:10px;
    background:#101722;
    border:1px solid #222e42;
    color:#79859a;
    font-size:11px;
    margin-bottom:15px;
}

.auth-switch{
    text-align:center;
    margin-top:15px;
    color:#7d899d;
    font-size:12px;
}

.auth-switch button{
    background:none;
    border:0;
    color:#7e96ff;
    font-weight:800;
}

/* ---------- COMPARE ---------- */

.compare-wrap{
    overflow:auto;
}

.compare-table{
    width:100%;
    border-collapse:collapse;
    min-width:650px;
}

.compare-table th,
.compare-table td{
    padding:13px;
    border-bottom:1px solid #222d40;
    text-align:left;
    font-size:12px;
}

.compare-table th{
    color:#aeb7c7;
}

.compare-table td:first-child{
    color:#68758a;
}

/* ---------- DASHBOARD ---------- */

.dashboard-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}

.dashboard-card{
    padding:20px;
    border:1px solid var(--border);
    border-radius:16px;
    background:#0a0e15;
}

.dashboard-card strong{
    font-size:27px;
    display:block;
}

.dashboard-card span{
    color:#718096;
    font-size:11px;
}

/* ---------- TOAST ---------- */

#toastContainer{
    position:fixed;
    right:17px;
    bottom:17px;
    z-index:6000;
    display:flex;
    flex-direction:column;
    gap:9px;
}

.toast{
    min-width:270px;
    max-width:380px;
    padding:14px 16px;
    border-radius:12px;
    background:#121925;
    border:1px solid #344158;
    color:#fff;
    box-shadow:0 15px 45px rgba(0,0,0,.45);
    animation:toastIn .22s ease;
    font-size:12px;
}

.toast.success{
    border-color:#2d684d;
}

.toast.error{
    border-color:#71333e;
}

.toast.warning{
    border-color:#6b5228;
}

@keyframes toastIn{
    from{
        opacity:0;
        transform:translateY(12px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* ---------- LOADER ---------- */

.loader{
    width:20px;
    height:20px;
    border:3px solid #303b4d;
    border-top-color:#fff;
    border-radius:50%;
    animation:spin .7s linear infinite;
}

@keyframes spin{
    to{
        transform:rotate(360deg);
    }
}

/* ---------- RESPONSIVE ---------- */

@media(max-width:1000px){

    .hero-grid{
        grid-template-columns:1fr;
    }

    .mobile-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .feature-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .category-grid{
        grid-template-columns:repeat(3,1fr);
    }

    .search-row{
        grid-template-columns:1fr 1fr;
    }

    .filter-row{
        grid-template-columns:1fr 1fr;
    }

    .contact-grid{
        grid-template-columns:1fr;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:720px){

    .nav-links,
    .nav-actions{
        display:none;
    }

    .menu-btn{
        display:block;
    }

    .hero{
        padding:60px 0 50px;
    }

    .hero h1{
        font-size:45px;
        letter-spacing:-2.5px;
    }

    .hero-description{
        font-size:15px;
    }

    .hero-showcase{
        min-height:390px;
    }

    .phone-stage{
        min-height:280px;
    }

    .big-phone{
        transform:scale(.85) rotate(-7deg);
    }

    section{
        padding:60px 0;
    }

    .section-header{
        display:block;
    }

    .section-header h2{
        font-size:28px;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .mobile-grid{
        grid-template-columns:1fr;
    }

    .category-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .feature-grid{
        grid-template-columns:1fr;
    }

    .steps{
        grid-template-columns:1fr;
    }

    .search-row,
    .filter-row{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }

    .sell-box{
        padding:20px;
    }

    .sell-benefits{
        grid-template-columns:1fr;
    }

    .safety-box{
        grid-template-columns:1fr;
    }

    .detail-layout{
        grid-template-columns:1fr;
    }

    .detail-photo{
        min-height:270px;
    }

    .footer-grid{
        grid-template-columns:1fr;
    }

    .dashboard-grid{
        grid-template-columns:1fr;
    }
}

</style>
</head>

<body>

<!-- =========================================================
     NAVBAR
     ========================================================= -->

<header class="navbar">

    <div class="container">

        <div class="nav-inner">

            <a href="#" class="logo">
                Mobile<span>Market</span>
            </a>

            <nav class="nav-links">

                <a href="#marketplace">
                    Mobiles
                </a>

                <a href="#categories">
                    Brands
                </a>

                <a href="#sell">
                    Sell
                </a>

                <a href="#why">
                    Why Us
                </a>

                <a href="#safety">
                    Safety
                </a>

                <a href="#contact">
                    Contact
                </a>

            </nav>

            <div class="nav-actions">

                <div id="userPill" class="user-pill">
                    <div id="userAvatar" class="user-avatar">
                        U
                    </div>
                    <span id="userNameNav">
                        User
                    </span>
                </div>

                <button
                    id="loginNavBtn"
                    class="btn btn-secondary"
                    onclick="openAuth('login')"
                >
                    Login
                </button>

                <button
                    id="sellNavBtn"
                    class="btn btn-primary"
                    onclick="scrollToSell()"
                >
                    Sell Phone
                </button>

                <button
                    id="logoutNavBtn"
                    class="btn btn-danger hidden"
                    onclick="logoutUser()"
                >
                    Logout
                </button>

            </div>

            <button
                class="menu-btn"
                onclick="toggleMobileNav()"
            >
                ☰
            </button>

        </div>

        <div id="mobileNav" class="mobile-nav">

            <a href="#marketplace" onclick="closeMobileNav()">
                Mobiles
            </a>

            <a href="#categories" onclick="closeMobileNav()">
                Brands
            </a>

            <a href="#sell" onclick="closeMobileNav()">
                Sell
            </a>

            <a href="#why" onclick="closeMobileNav()">
                Why Us
            </a>

            <a href="#safety" onclick="closeMobileNav()">
                Safety
            </a>

            <a href="#contact" onclick="closeMobileNav()">
                Contact
            </a>

            <button
                onclick="openAuth('login');closeMobileNav()"
            >
                Login
            </button>

        </div>

    </div>

</header>


<!-- =========================================================
     HERO
     ========================================================= -->

<section class="hero">

    <div class="container hero-grid">

        <div>

            <div class="hero-label">
                <span class="live-dot"></span>
                SMARTPHONE MARKETPLACE
            </div>

            <h1>
                Buy Smart.<br>
                <span>Sell Easy.</span>
            </h1>

            <p class="hero-description">
                Discover smartphones, compare specifications,
                save favourites and connect with sellers.
                Built for a modern mobile marketplace.
            </p>

            <div class="hero-buttons">

                <button
                    class="btn btn-primary"
                    onclick="document.getElementById('marketplace').scrollIntoView()"
                >
                    🔎 Explore Mobiles
                </button>

                <button
                    class="btn btn-secondary"
                    onclick="scrollToSell()"
                >
                    📱 Sell Your Phone
                </button>

            </div>

            <div class="hero-trust">

                <span>✓ Search & Filters</span>
                <span>✓ Compare Phones</span>
                <span>✓ Seller Enquiries</span>
                <span>✓ Wishlist</span>

            </div>

            <div class="stats">

                <div class="stat">
                    <strong id="heroListingCount">0</strong>
                    <span>Phone Listings</span>
                </div>

                <div class="stat">
                    <strong>10+</strong>
                    <span>Popular Brands</span>
                </div>

                <div class="stat">
                    <strong>24/7</strong>
                    <span>Marketplace Access</span>
                </div>

                <div class="stat">
                    <strong>100%</strong>
                    <span>Mobile Friendly</span>
                </div>

            </div>

        </div>


        <div class="hero-showcase">

            <div class="showcase-top">
                <span>MOBILEMARKET</span>
                <span>2026</span>
            </div>

            <div class="phone-stage">

                <div class="big-phone">

                    <div class="phone-camera">
                        <i></i>
                        <i></i>
                        <i></i>
                    </div>

                    <div class="phone-screen-text">
                        FIND YOUR PHONE
                    </div>

                </div>

            </div>

            <div class="showcase-bottom">
                <span>Premium marketplace</span>
                <span>MM</span>
            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MARKETPLACE
     ========================================================= -->

<section id="marketplace">

    <div class="container">

        <div class="section-header">

            <div>

                <h2>
                    Explore Mobiles
                </h2>

                <p>
                    Search thousands of possibilities as your marketplace grows.
                </p>

            </div>

            <button
                class="btn btn-secondary"
                onclick="openCompare()"
            >
                ⚖ Compare
            </button>

        </div>


        <!-- SEARCH + FILTER -->

        <div class="market-toolbar">

            <div class="search-row">

                <input
                    id="searchInput"
                    class="input"
                    type="search"
                    placeholder="Search iPhone, Samsung S23, Vivo..."
                    oninput="renderListings()"
                >

                <select
                    id="brandFilter"
                    class="select"
                    onchange="renderListings()"
                >
                    <option value="">All Brands</option>
                    <option>Apple</option>
                    <option>Samsung</option>
                    <option>Vivo</option>
                    <option>OnePlus</option>
                    <option>Motorola</option>
                    <option>Xiaomi</option>
                    <option>Realme</option>
                    <option>Oppo</option>
                    <option>Google</option>
                    <option>Nothing</option>
                </select>

                <select
                    id="conditionFilter"
                    class="select"
                    onchange="renderListings()"
                >
                    <option value="">All Conditions</option>
                    <option>Like New</option>
                    <option>Excellent</option>
                    <option>Good</option>
                    <option>Fair</option>
                </select>

                <select
                    id="sortFilter"
                    class="select"
                    onchange="renderListings()"
                >
                    <option value="newest">Newest First</option>
                    <option value="low">Price Low → High</option>
                    <option value="high">Price High → Low</option>
                    <option value="battery">Battery Health</option>
                </select>

            </div>


            <div class="filter-row">

                <input
                    id="minPrice"
                    class="input"
                    type="number"
                    placeholder="Min price ₹"
                    oninput="renderListings()"
                >

                <input
                    id="maxPrice"
                    class="input"
                    type="number"
                    placeholder="Max price ₹"
                    oninput="renderListings()"
                >

                <select
                    id="storageFilter"
                    class="select"
                    onchange="renderListings()"
                >
                    <option value="">Any Storage</option>
                    <option>64GB</option>
                    <option>128GB</option>
                    <option>256GB</option>
                    <option>512GB</option>
                    <option>1TB</option>
                </select>

                <select
                    id="ramFilter"
                    class="select"
                    onchange="renderListings()"
                >
                    <option value="">Any RAM</option>
                    <option>4GB</option>
                    <option>6GB</option>
                    <option>8GB</option>
                    <option>12GB</option>
                    <option>16GB</option>
                </select>

                <button
                    class="btn btn-secondary"
                    onclick="resetFilters()"
                >
                    Reset
                </button>

            </div>

        </div>


        <!-- BRAND CHIPS -->

        <div class="brand-strip">

            <button
                class="brand-chip active"
                onclick="selectBrand('')"
            >
                All
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Apple')"
            >
                Apple
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Samsung')"
            >
                Samsung
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Vivo')"
            >
                Vivo
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('OnePlus')"
            >
                OnePlus
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Motorola')"
            >
                Motorola
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Xiaomi')"
            >
                Xiaomi
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Realme')"
            >
                Realme
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Oppo')"
            >
                Oppo
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Google')"
            >
                Google
            </button>

            <button
                class="brand-chip"
                onclick="selectBrand('Nothing')"
            >
                Nothing
            </button>

        </div>


        <div class="results-line">

            <span id="resultText">
                Loading listings...
            </span>

            <span>
                💡 Compare up to 2 phones
            </span>

        </div>


        <div
            id="mobileGrid"
            class="mobile-grid"
        ></div>


        <div
            id="emptyState"
            class="empty-state hidden"
        >

            <div class="empty-icon">
                📱
            </div>

            <h3>
                No phones found
            </h3>

            <p>
                Try another search, brand or price range.
            </p>

            <button
                class="btn btn-secondary"
                style="margin-top:15px;"
                onclick="resetFilters()"
            >
                Reset Filters
            </button>

        </div>

    </div>

</section>


<!-- =========================================================
     CATEGORIES
     ========================================================= -->

<section id="categories">

    <div class="container">

        <div class="section-header">

            <div>

                <h2>
                    Browse By Brand
                </h2>

                <p>
                    Quickly discover phones from popular manufacturers.
                </p>

            </div>

        </div>


        <div class="category-grid">

            <button class="category" onclick="selectBrand('Apple')">
                <div class="category-icon">🍎</div>
                <strong>Apple</strong>
                <small>iPhone</small>
            </button>

            <button class="category" onclick="selectBrand('Samsung')">
                <div class="category-icon">📱</div>
                <strong>Samsung</strong>
                <small>Galaxy</small>
            </button>

            <button class="category" onclick="selectBrand('Vivo')">
                <div class="category-icon">📷</div>
                <strong>Vivo</strong>
                <small>Smartphones</small>
            </button>

            <button class="category" onclick="selectBrand('OnePlus')">
                <div class="category-icon">⚡</div>
                <strong>OnePlus</strong>
                <small>Performance</small>
            </button>

            <button class="category" onclick="selectBrand('Motorola')">
                <div class="category-icon">〽️</div>
                <strong>Motorola</strong>
                <small>Edge Series</small>
            </button>

            <button class="category" onclick="selectBrand('Xiaomi')">
                <div class="category-icon">🔥</div>
                <strong>Xiaomi</strong>
                <small>Redmi</small>
            </button>

            <button class="category" onclick="selectBrand('Realme')">
                <div class="category-icon">⚡</div>
                <strong>Realme</strong>
                <small>GT Series</small>
            </button>

            <button class="category" onclick="selectBrand('Oppo')">
                <div class="category-icon">📸</div>
                <strong>Oppo</strong>
                <small>Camera Phones</small>
            </button>

            <button class="category" onclick="selectBrand('Google')">
                <div class="category-icon">G</div>
                <strong>Google</strong>
                <small>Pixel</small>
            </button>

            <button class="category" onclick="selectBrand('Nothing')">
                <div class="category-icon">◻️</div>
                <strong>Nothing</strong>
                <small>Phone Series</small>
            </button>

        </div>

    </div>

</section>


<!-- =========================================================
     WHY US
     ========================================================= -->

<section id="why" class="why-section">

    <div class="container">

        <div class="section-header">

            <div>

                <h2>
                    Built For Smartphone Buyers
                </h2>

                <p>
                    Useful tools instead of just a basic product catalogue.
                </p>

            </div>

        </div>


        <div class="feature-grid">

            <div class="feature">

                <div class="feature-icon">
                    🔎
                </div>

                <h3>
                    Powerful Search
                </h3>

                <p>
                    Search by brand, model, storage, RAM, condition and price.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    ⚖️
                </div>

                <h3>
                    Phone Comparison
                </h3>

                <p>
                    Put two phones side by side and compare their important details.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    ❤️
                </div>

                <h3>
                    Wishlist
                </h3>

                <p>
                    Save phones you are interested in so you can find them again.
                </p>

            </div>


            <div class="feature">

                <div class="feature-icon">
                    📩
                </div>

                <h3>
                    Seller Enquiry
                </h3>

                <p>
                    Send a message about a listing without publicly displaying private information.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW IT WORKS
     ========================================================= -->

<section>

    <div class="container">

        <div class="section-header">

            <div>

                <h2>
                    How It Works
                </h2>

                <p>
                    Simple steps for buyers and sellers.
                </p>

            </div>

        </div>


        <div class="steps">

            <div class="step">

                <div class="step-number">
                    STEP 01
                </div>

                <h3>
                    Find a Phone
                </h3>

                <p>
                    Search listings and use filters to find phones matching your budget and requirements.
                </p>

            </div>


            <div class="step">

                <div class="step-number">
                    STEP 02
                </div>

                <h3>
                    Check Details
                </h3>

                <p>
                    Open a listing to see price, condition, battery, RAM, storage and seller information.
                </p>

            </div>


            <div class="step">

                <div class="step-number">
                    STEP 03
                </div>

                <h3>
                    Contact Seller
                </h3>

                <p>
                    Send an enquiry and discuss the phone directly with the seller.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SELL SECTION
     ========================================================= -->

<section id="sell" class="sell-section">

    <div class="container">

        <div class="section-header">

            <div>

                <h2>
                    Sell Your Smartphone
                </h2>

                <p>
                    Add your phone to the marketplace.
                </p>

            </div>

        </div>


        <div class="sell-box">

            <form
                id="sellForm"
                onsubmit="submitListing(event)"
            >

                <div class="form-grid">

                    <div class="form-group">

                        <label>
                            Seller Name *
                        </label>

                        <input
                            id="sellerName"
                            class="input"
                            required
                            placeholder="Your name"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Phone / WhatsApp *
                        </label>

                        <input
                            id="sellerPhone"
                            class="input"
                            required
                            inputmode="numeric"
                            placeholder="10 digit mobile number"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Email
                        </label>

                        <input
                            id="sellerEmail"
                            class="input"
                            type="email"
                            placeholder="you@example.com"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            City *
                        </label>

                        <input
                            id="sellerCity"
                            class="input"
                            required
                            placeholder="Mumbai"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Brand *
                        </label>

                        <select
                            id="sellBrand"
                            class="select"
                            required
                        >

                            <option value="">
                                Select brand
                            </option>

                            <option>Apple</option>
                            <option>Samsung</option>
                            <option>Vivo</option>
                            <option>OnePlus</option>
                            <option>Motorola</option>
                            <option>Xiaomi</option>
                            <option>Realme</option>
                            <option>Oppo</option>
                            <option>Google</option>
                            <option>Nothing</option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>
                            Model *
                        </label>

                        <input
                            id="sellModel"
                            class="input"
                            required
                            placeholder="Example: iPhone 14"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            RAM
                        </label>

                        <select
                            id="sellRam"
                            class="select"
                        >

                            <option value="">
