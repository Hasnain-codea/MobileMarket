                        </label>

                        <textarea
                            id="sellDescription"
                            class="textarea"
                            placeholder="Mention scratches, box, charger, warranty, repairs, usage and other important details."
                        ></textarea>

                    </div>


                    <div class="form-group full">

                        <button
                            class="btn btn-primary"
                            type="submit"
                        >
                            📱 Create Listing
                        </button>

                    </div>

                </div>

                <p class="form-hint" style="margin-top:15px;">
                    Safety: Never share OTPs, passwords, PINs or banking credentials with another user.
                </p>

            </form>


            <div class="sell-benefits">

                <div class="sell-benefit">
                    <strong>📋 Detailed Listing</strong>
